---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

// Entries live in src/content/activities/activities.json — add photos by
// dropping them in src/assets/activities/ and setting "image".
const activities = (await getCollection("activities")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Clubs & Activities"
  description="Clubs and extracurricular activities for Sid Agrawal."
>
  <main class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="font-hand text-2xl text-[color:var(--color-accent)] dark:text-[color:var(--color-accent-dark)]">
        beyond the code
      </p>
      <div class="works-intro mt-2">
        <h1 class="works-title">Clubs <br />&amp; Activities</h1>
        <p class="works-note">
          The groups and activities I'm part of outside of shipped projects and volunteer work.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {activities.map((entry) => {
          const { name, role, period, desc, tags, url, image, imageAlt } = entry.data;
          return (
            <article class="entry-card">
              {image && (
                <div class="entry-photo">
                  <Image src={image} alt={imageAlt ?? `${role} at ${name}`} widths={[400, 800]} sizes="(min-width: 640px) 24rem, 100vw" />
                </div>
              )}
              <div class="entry-body">
                <p class="font-display text-[0.65rem] font-bold tracking-widest text-[color:var(--color-accent)] uppercase dark:text-[color:var(--color-accent-dark)]">
                  {period}
                </p>
                <h3 class="mt-2 font-display text-lg font-bold">{role}</h3>
                {url ? (
                  <a href={url} target="_blank" rel="noopener" class="text-sm font-semibold text-black/60 underline-offset-4 hover:underline dark:text-white/60">
                    {name} ↗
                  </a>
                ) : (
                  <p class="text-sm font-semibold text-black/60 dark:text-white/60">{name}</p>
                )}
                <p class="mt-3 text-sm text-black/60 dark:text-white/60">{desc}</p>
                {tags.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {tags.map((tag) => (
                      <span class="rounded-full bg-black/5 px-2.5 py-1 text-xs font-semibold text-black/60 dark:bg-white/10 dark:text-white/60">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <div class="mt-16 rounded-2xl border border-black/10 p-6 text-center dark:border-white/10">
        <p class="text-black/60 dark:text-white/60">Want to see the volunteer work and awards too?</p>
        <div class="mt-2 flex items-center justify-center gap-4 font-semibold text-[color:var(--color-accent)] dark:text-[color:var(--color-accent-dark)]">
          <a href="/volunteering/">Volunteering →</a>
          <a href="/awards/">Awards →</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .entry-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid rgba(0, 0, 0, 0.8);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.6);
    box-shadow: 4px 4px 0 #000;
  }

  :global([data-theme="dark"]) .entry-card {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(27, 27, 31, 0.6);
    box-shadow: 4px 4px 0 rgba(255, 255, 255, 0.25);
  }

  .entry-body {
    padding: 1.5rem;
  }

  /* Photos sit flush to the card edge, cropped to a consistent band. */
  .entry-photo {
    position: relative;
    border-bottom: 2px solid rgba(0, 0, 0, 0.8);
  }

  :global([data-theme="dark"]) .entry-photo {
    border-bottom-color: rgba(255, 255, 255, 0.7);
  }

  .entry-photo :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
</style>
